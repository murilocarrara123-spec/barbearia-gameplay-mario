# Porta local
PORT=3000

# OpenAI
# Coloque sua chave real aqui no arquivo .env, nunca no código.
OPENAI_API_KEY=

# WhatsApp Cloud API / Meta
# Esses dados você pega no painel da Meta/WhatsApp Business Platform.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VERIFY_TOKEN=gameplay_mario_token

# Modo teste
# true = não envia WhatsApp real, só mostra no console e responde no Postman/navegador
# false = tenta enviar pela API oficial do WhatsApp
MOCK_WHATSAPP=true
